# Public repository is opt-in. Local research evidence must never be staged implicitly.
/*
!/.gitignore
!/.gitattributes
!/.no-mistakes.yaml
!/README.md
!/LICENSE

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/quality.yml

!/docs/
/docs/*
!/docs/public/
/docs/public/*
!/docs/public/GITHUB_WORKFLOW.md
!/docs/public/B210_INSTRUMENT.md

!/tools/
/tools/*
!/tools/check_public_tree.py
!/tools/b210_instrument.py
!/tools/b210_live.py

!/tests/
/tests/*
!/tests/public/
/tests/public/*
!/tests/public/test_public_tree.py
!/tests/public/test_b210_instrument.py
!/tests/public/test_b210_live.py

# Defense in depth; no tracked files are removed by these rules.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/venv/
**/.env
**/.env.*
**/*.pem
**/*.key
